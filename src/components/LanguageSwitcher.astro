---
import { locales, localeLabels, type Locale } from '@/i18n/config';
import { useTranslations } from '@/i18n';
import { switchLocale } from '@/lib/url';

interface Props { lang: Locale }
const { lang } = Astro.props;
const { t } = useTranslations(lang);
---
<nav class="seg lang-switcher" aria-label={t('nav.language')}>
  {
    locales.map((l) => (
      <a
        href={switchLocale(Astro.url.pathname, l)}
        hreflang={localeLabels[l].htmlLang}
        lang={localeLabels[l].htmlLang}
        title={localeLabels[l].name}
        aria-current={l === lang ? 'true' : undefined}
        data-lang-link={l}
      >
        {localeLabels[l].short}
      </a>
    ))
  }
</nav>

<script>
  // Remember the explicit choice so the root redirect honours it next time.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((a) =>
    a.addEventListener('click', () => {
      try { localStorage.setItem('lang', a.dataset.langLink!); } catch {}
    }),
  );
</script>
