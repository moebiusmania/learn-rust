---
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n/config';
interface Props { lang: Locale }
const { t } = useTranslations(Astro.props.lang);
---
<footer class="site-footer">
  <div class="container">
    <p>{t('footer.text')}</p>
    <p class="muted">{t('footer.notAffiliated')}</p>
  </div>
</footer>
