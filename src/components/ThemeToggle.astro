---
import Icon from './Icon.astro';
import { useTranslations } from '@/i18n';
import type { Locale } from '@/i18n/config';

interface Props { lang: Locale }
const { t } = useTranslations(Astro.props.lang);
const modes = [
  { id: 'auto', icon: 'monitor', label: t('nav.themeAuto') },
  { id: 'light', icon: 'sun', label: t('nav.themeLight') },
  { id: 'dark', icon: 'moon', label: t('nav.themeDark') },
] as const;
---
<div class="seg seg-icon theme-toggle" role="group" aria-label={t('nav.theme')}>
  {
    modes.map((m) => (
      <button type="button" data-theme-set={m.id} aria-pressed="false" title={m.label}>
        <Icon name={m.icon} label={m.label} />
      </button>
    ))
  }
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-set]');
  function apply(mode: string) {
    if (mode === 'auto') delete document.documentElement.dataset.theme;
    else document.documentElement.dataset.theme = mode;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeSet === mode)));
  }
  let current = 'auto';
  try { current = localStorage.getItem('theme') ?? 'auto'; } catch {}
  apply(current);
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const mode = b.dataset.themeSet!;
      try { localStorage.setItem('theme', mode); } catch {}
      apply(mode);
    }),
  );
</script>
