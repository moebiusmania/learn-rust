---
/**
 * Stepper over a function that chains three fallible calls with `?`.
 * The reader picks which call fails; an SVG token follows either the happy
 * path down to Ok(cfg) or the early-return branch, while the code listing
 * and the desugared `match` for the current `?` stay in sync.
 */
import WidgetFrame from '@/components/content/WidgetFrame.astro';
import Icon from '@/components/Icon.astro';
import { getLang, widgetStrings } from '@/i18n';
import { highlightRustLines } from '@/scripts/rust-highlight';

interface Strings {
  title: string; subtitle: string; failLabel: string; none: string; step: string; reset: string; play: string;
  okNode: string; exitNode: string; errBranch: string; desugarTitle: string;
  captions: Record<'start' | 'call' | 'ok' | 'err' | 'returnErr' | 'returnOk', string>;
}
const s = widgetStrings<Strings>(getLang(Astro), 'question-mark-flow');

const code = `fn load_config(path: &str) -> Result<Config, AppError> {
    let text = read_file(path)?;
    let raw = parse_toml(&text)?;
    let cfg = validate(raw)?;
    Ok(cfg)
}`;
const lines = highlightRustLines(code);
const calls = [
  { fn: 'read_file', label: 'read_file(path)?', bind: 'text', expr: 'read_file(path)' },
  { fn: 'parse_toml', label: 'parse_toml(&text)?', bind: 'raw', expr: 'parse_toml(&text)' },
  { fn: 'validate', label: 'validate(raw)?', bind: 'cfg', expr: 'validate(raw)' },
];
const desugars = calls.map((c) =>
  highlightRustLines(`let ${c.bind} = match ${c.expr} {
    Ok(v) => v,
    Err(e) => return Err(From::from(e)),
};`),
);
const callY = [78, 148, 218];
---
<WidgetFrame
  tag="question-mark-flow"
  title={s.title}
  subtitle={s.subtitle}
  icon="branch"
  data-captions={JSON.stringify(s.captions)}
  data-calls={JSON.stringify(calls.map((c) => c.fn))}
>
  <div class="widget-controls qm-top">
    <span class="qm-label" id="qm-fail-label">{s.failLabel}</span>
    <div class="seg" role="group" aria-labelledby="qm-fail-label">
      <button type="button" data-fail="0" aria-pressed="true">{s.none}</button>
      {calls.map((c, i) => <button type="button" data-fail={i + 1} aria-pressed="false"><code>{c.fn}</code></button>)}
    </div>
  </div>

  <div class="qm-grid">
    <svg class="qm-flow" viewBox="0 0 540 330" role="img" aria-label={s.title}>
      <!-- happy-path rail -->
      {[46, ...callY.map((y) => y + 40)].map((y, i) => (
        <line class="rail" data-rail={i} x1="150" y1={y} x2="150" y2={i < 3 ? callY[i] : 286} />
      ))}
      <g class="node caller" data-node="caller">
        <rect x="40" y="10" width="220" height="36" rx="10" />
        <text x="150" y="33" text-anchor="middle">load_config("app.toml")</text>
      </g>
      {calls.map((c, i) => (
        <g>
          <path class="branch" data-branch={i + 1} d={`M260 ${callY[i]! + 20} H330`} />
          <path class="branch-rail" data-branch-rail={i + 1} d={`M440 ${callY[i]! + 20} H490 V286`} />
          <g class="node call" data-node={`call-${i + 1}`}>
            <rect x="40" y={callY[i]} width="220" height="40" rx="10" />
            <text x="150" y={callY[i]! + 25} text-anchor="middle">{c.label}</text>
          </g>
          <g class="node pill" data-node={`err-${i + 1}`}>
            <rect x="330" y={callY[i]! + 6} width="110" height="28" rx="14" />
            <text x="385" y={callY[i]! + 25} text-anchor="middle">{s.errBranch}</text>
          </g>
        </g>
      ))}
      <g class="node ok" data-node="ok">
        <rect x="40" y="286" width="220" height="36" rx="10" />
        <text x="150" y="309" text-anchor="middle">{s.okNode}</text>
      </g>
      <g class="node exit" data-node="exit">
        <rect x="330" y="286" width="190" height="36" rx="10" />
        <text x="425" y="309" text-anchor="middle">{s.exitNode}</text>
      </g>
      <circle class="token" r="8" cx="0" cy="0" />
    </svg>

    <div class="qm-code">
      <pre class="code-lines" data-code>{lines.map((l) => <span class="ln" set:html={l} />)}</pre>
      <div class="qm-desugar">
        <span class="qm-label">{s.desugarTitle}</span>
        {desugars.map((d, i) => (
          <pre class="code-lines" data-desugar={i + 1} hidden={i !== 0}>{d.map((l) => <span class="ln" set:html={l} />)}</pre>
        ))}
      </div>
    </div>
  </div>

  <div class="widget-caption" aria-live="polite" data-caption></div>
  <div class="widget-controls">
    <button type="button" class="btn btn-sm" data-step><Icon name="next" size={14} /><span>{s.step}</span></button>
    <button type="button" class="btn btn-sm btn-ghost" data-play><Icon name="play" size={14} /><span>{s.play}</span></button>
    <button type="button" class="btn btn-sm btn-ghost" data-reset><Icon name="reset" size={14} /><span>{s.reset}</span></button>
    <div class="steps-dots" aria-hidden="true" data-dots></div>
  </div>
</WidgetFrame>

<script>
  type Kind = 'start' | 'call' | 'ok' | 'err' | 'returnErr' | 'returnOk';
  interface Step { kind: Kind; call: number }

  const POS: Record<string, [number, number]> = {
    // token sits on the left edge of each node, clear of the labels
    caller: [40, 28],
    'call-1': [40, 98], 'call-2': [40, 168], 'call-3': [40, 238],
    'err-1': [330, 98], 'err-2': [330, 168], 'err-3': [330, 238],
    ok: [40, 304], exit: [330, 304],
  };

  class QuestionMarkFlow extends HTMLElement {
    #fail = 0;
    #steps: Step[] = [];
    #i = 0;
    #timer: number | undefined;
    #captions: Record<Kind, string> = {} as Record<Kind, string>;
    #calls: string[] = [];

    connectedCallback() {
      this.#captions = JSON.parse(this.dataset.captions!);
      this.#calls = JSON.parse(this.dataset.calls!);
      this.querySelectorAll<HTMLButtonElement>('[data-fail]').forEach((b) =>
        b.addEventListener('click', () => {
          this.#fail = Number(b.dataset.fail);
          this.querySelectorAll('[data-fail]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          this.#restart();
        }),
      );
      this.querySelector('[data-step]')!.addEventListener('click', () => { this.#stop(); this.#next(); });
      this.querySelector('[data-reset]')!.addEventListener('click', () => { this.#stop(); this.#restart(); });
      this.querySelector('[data-play]')!.addEventListener('click', () => (this.#timer ? this.#stop() : this.#play()));
      this.#restart();
    }

    disconnectedCallback() { this.#stop(); }

    #build() {
      const steps: Step[] = [{ kind: 'start', call: 0 }];
      for (let c = 1; c <= 3; c++) {
        steps.push({ kind: 'call', call: c });
        if (c === this.#fail) {
          steps.push({ kind: 'err', call: c }, { kind: 'returnErr', call: c });
          return steps;
        }
        steps.push({ kind: 'ok', call: c });
      }
      steps.push({ kind: 'returnOk', call: 3 });
      return steps;
    }

    #restart() {
      this.#steps = this.#build();
      this.#i = 0;
      this.querySelector('[data-dots]')!.innerHTML = this.#steps.map(() => '<span></span>').join('');
      this.#render();
    }

    #next() {
      if (this.#i >= this.#steps.length - 1) return this.#restart();
      this.#i++;
      this.#render();
    }

    #play() {
      if (this.#i >= this.#steps.length - 1) this.#restart();
      this.#setPlay(true);
      this.#timer = window.setInterval(() => {
        if (this.#i >= this.#steps.length - 1) return this.#stop();
        this.#next();
      }, 1500);
    }

    #stop() {
      clearInterval(this.#timer);
      this.#timer = undefined;
      this.#setPlay(false);
    }

    #setPlay(on: boolean) {
      this.querySelector('[data-play] svg')!.innerHTML = on ? '<path d="M8 5v14M16 5v14"/>' : '<path d="M7 4.5v15l12.5-7.5z"/>';
    }

    #render() {
      const step = this.#steps[this.#i]!;
      const failed = step.kind === 'err' || step.kind === 'returnErr';
      // where the token sits
      const at =
        step.kind === 'start' ? 'caller'
        : step.kind === 'err' ? `err-${step.call}`
        : step.kind === 'returnErr' ? 'exit'
        : step.kind === 'returnOk' ? 'ok'
        : `call-${step.call}`;
      const [x, y] = POS[at]!;
      const token = this.querySelector<SVGCircleElement>('.token')!;
      token.style.transform = `translate(${x}px, ${y}px)`;
      token.classList.toggle('is-err', failed);

      // node states
      this.querySelectorAll<SVGGElement>('[data-node]').forEach((g) => {
        const id = g.dataset.node!;
        const n = Number(id.split('-')[1]);
        const passed = id.startsWith('call-') && (n < step.call || (n === step.call && step.kind === 'ok') || step.kind === 'returnOk');
        g.classList.toggle('active', id === at);
        g.classList.toggle('passed', id === 'caller' ? this.#i > 0 : passed);
        g.classList.toggle('failed', failed && (id === `call-${step.call}` || id === `err-${step.call}` || (id === 'exit' && step.kind === 'returnErr')));
      });
      this.querySelectorAll<SVGLineElement>('[data-rail]').forEach((l) => {
        const r = Number(l.dataset.rail);
        // rail r connects node r to node r + 1 (0 = caller, 3 = Ok)
        const reached = r === 0 ? step.call >= 1 : r < 3 ? step.call > r : step.kind === 'returnOk';
        l.classList.toggle('on', reached);
      });
      this.querySelectorAll<SVGPathElement>('[data-branch]').forEach((p) =>
        p.classList.toggle('on', failed && Number(p.dataset.branch) === step.call),
      );
      this.querySelectorAll<SVGPathElement>('[data-branch-rail]').forEach((p) =>
        p.classList.toggle('on', step.kind === 'returnErr' && Number(p.dataset.branchRail) === step.call),
      );

      // code listing: line 0 is the signature, lines 1..3 the calls, 4 the Ok
      const activeLine = step.kind === 'start' ? 0 : step.kind === 'returnOk' ? 4 : step.call;
      this.querySelectorAll<HTMLElement>('[data-code] .ln').forEach((ln, i) => {
        ln.classList.toggle('is-active', i === activeLine && !failed);
        ln.classList.toggle('is-error', failed && i === step.call);
        ln.classList.toggle('is-dim', failed && i > step.call && i < 5);
      });

      // desugared match for the current ?
      const shown = Math.max(1, step.call);
      this.querySelectorAll<HTMLElement>('[data-desugar]').forEach((pre) => {
        const mine = Number(pre.dataset.desugar) === shown;
        pre.hidden = !mine;
        if (!mine) return;
        pre.querySelectorAll('.ln').forEach((ln, i) => {
          ln.classList.toggle('is-active', step.kind === 'ok' && i === 1);
          ln.classList.toggle('is-error', failed && i === 2);
          ln.classList.toggle('is-dim', step.kind === 'start');
        });
      });

      const fn = this.#calls[step.call - 1] ?? '';
      this.querySelector<HTMLElement>('[data-caption]')!.innerHTML = this.#captions[step.kind].replaceAll('{fn}', fn);
      this.querySelectorAll('[data-dots] span').forEach((d, i) => d.classList.toggle('on', i === this.#i));
    }
  }
  customElements.define('question-mark-flow', QuestionMarkFlow);
</script>

<style>
  question-mark-flow { display: block; }
  .qm-top { gap: var(--space-3); }
  .qm-top code { font-size: 0.72rem; background: none; border: 0; padding: 0; }
  .qm-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-faint); }
  .qm-grid { display: grid; gap: var(--space-4); grid-template-columns: minmax(0, 1fr); }
  @container widget (width >= 56rem) {
    .qm-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); align-items: start; }
  }
  .qm-code { display: grid; gap: var(--space-3); min-inline-size: 0; }
  .qm-code .code-lines { font-size: 0.74rem; }
  .qm-desugar { display: grid; gap: var(--space-2); }

  .qm-flow { inline-size: 100%; max-inline-size: 36rem; justify-self: center; block-size: auto; font-family: var(--font-mono); overflow: visible; }
  .node rect { fill: var(--surface); stroke: var(--border-strong); stroke-width: 1.5; transition: fill 300ms, stroke 300ms; }
  .node text { font-size: 13px; fill: var(--text-muted); transition: fill 300ms; }
  .node.passed rect { stroke: var(--ok); fill: color-mix(in oklch, var(--ok) 10%, var(--surface)); }
  .node.active rect { stroke: var(--accent); fill: var(--accent-soft); stroke-width: 2; }
  .node.active text, .node.passed text { fill: var(--text); }
  .node.failed rect { stroke: var(--danger); fill: color-mix(in oklch, var(--danger) 12%, var(--surface)); }
  .node.failed text { fill: var(--danger); }
  .pill rect { stroke-dasharray: 4 3; }
  .pill text, .exit text { font-size: 12px; }
  .ok.active rect { stroke: var(--ok); fill: color-mix(in oklch, var(--ok) 18%, var(--surface)); }

  .rail { stroke: var(--border-strong); stroke-width: 2; transition: stroke 300ms; }
  .rail.on { stroke: var(--ok); }
  .branch, .branch-rail { fill: none; stroke: var(--border); stroke-width: 2; stroke-dasharray: 5 4; transition: stroke 300ms; }
  .branch.on, .branch-rail.on { stroke: var(--danger); stroke-dasharray: none; }

  .token {
    fill: var(--accent); stroke: var(--surface); stroke-width: 3;
    transition: transform 650ms var(--ease-out), fill 300ms;
    filter: drop-shadow(0 2px 6px color-mix(in oklch, var(--accent) 50%, transparent));
  }
  .token.is-err { fill: var(--danger); }
  [data-caption] { animation: fade-up 300ms var(--ease-out); }
</style>
