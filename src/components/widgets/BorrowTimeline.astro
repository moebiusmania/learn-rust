---
/**
 * Borrow timeline: preset scenarios rendered at build time as a code listing
 * plus a Gantt-style SVG where each bar is a borrow's live range (in lines).
 * Overlaps between an exclusive borrow and any other borrow are flagged.
 */
import WidgetFrame from '@/components/content/WidgetFrame.astro';
import Icon from '@/components/Icon.astro';
import { getLang, widgetStrings } from '@/i18n';
import { highlightRustLines } from '@/scripts/rust-highlight';

interface Strings {
  title: string; subtitle: string; line: string; shared: string; mut: string; conflict: string;
  lexical: string; ok: string; fail: string;
  scenarios: { label: string; text: string }[];
  errors: string[];
}
const s = widgetStrings<Strings>(getLang(Astro), 'borrow-timeline');

type Borrow = { label: string; kind: 'shared' | 'mut'; from: number; to: number; lexicalTo?: number };
type Scenario = { code: string; borrows: Borrow[]; errorLine?: number };

// line numbers are 1-based
const scenarios: Scenario[] = [
  {
    code: `let mut v = vec![1, 2, 3];
let a = &v;
let b = &v;
println!("{a:?} {b:?}");
v.push(4);
println!("{v:?}");`,
    borrows: [
      { label: 'a = &v', kind: 'shared', from: 2, to: 4, lexicalTo: 6 },
      { label: 'b = &v', kind: 'shared', from: 3, to: 4, lexicalTo: 6 },
      { label: 'v.push(…)', kind: 'mut', from: 5, to: 5 },
      { label: 'println!(v)', kind: 'shared', from: 6, to: 6 },
    ],
  },
  {
    code: `let mut v = vec![1, 2, 3];
let first = &v[0];
v.push(4);
println!("{first}");`,
    borrows: [
      { label: 'first = &v[0]', kind: 'shared', from: 2, to: 4 },
      { label: 'v.push(…)', kind: 'mut', from: 3, to: 3 },
    ],
    errorLine: 3,
  },
  {
    code: `let mut s = String::from("hi");
let r1 = &mut s;
let r2 = &mut s;
r1.push('!');
r2.push('?');`,
    borrows: [
      { label: 'r1 = &mut s', kind: 'mut', from: 2, to: 4 },
      { label: 'r2 = &mut s', kind: 'mut', from: 3, to: 5 },
    ],
    errorLine: 3,
  },
  {
    code: `let mut s = String::from("hi");
let r1 = &mut s;
r1.push('!');
let r2 = &s;
println!("{r2}");`,
    borrows: [
      { label: 'r1 = &mut s', kind: 'mut', from: 2, to: 3, lexicalTo: 5 },
      { label: 'r2 = &s', kind: 'shared', from: 4, to: 5 },
    ],
  },
];

const COL = 56;
const LABEL = 118;
const ROW = 34;
const TOP = 26;

const rendered = scenarios.map((sc) => {
  const lines = highlightRustLines(sc.code);
  const n = lines.length;
  const conflicts: number[] = [];
  for (let l = 1; l <= n; l++) {
    const live = sc.borrows.filter((b) => b.from <= l && l <= b.to);
    if (live.length >= 2 && live.some((b) => b.kind === 'mut')) conflicts.push(l);
  }
  const width = LABEL + n * COL + 8;
  const height = TOP + sc.borrows.length * ROW + 8;
  return { ...sc, lines, n, conflicts, width, height, valid: conflicts.length === 0 };
});
const x = (line: number) => LABEL + (line - 1) * COL;
---
<WidgetFrame tag="borrow-timeline" title={s.title} subtitle={s.subtitle} icon="branch">
  <div class="seg bt-tabs" role="tablist" aria-label={s.title}>
    {s.scenarios.map((sc, i) => (
      <button type="button" role="tab" data-tab={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-selected={i === 0 ? 'true' : 'false'}>
        {sc.label}
      </button>
    ))}
  </div>

  {rendered.map((sc, i) => (
    <div class="bt-scenario" data-scenario={i} hidden={i !== 0}>
      <div class="bt-status" data-valid={String(sc.valid)}>
        <Icon name={sc.valid ? 'check' : 'alert'} size={16} />
        <span>{sc.valid ? s.ok : s.fail}</span>
      </div>
      <pre class="code-lines">{sc.lines.map((l, k) => (
        <span class:list={['ln', { 'is-error': sc.errorLine === k + 1 }]} data-line={k + 1} set:html={l} />
      ))}</pre>
      <div class="bt-chart-wrap">
        <svg class="bt-chart" viewBox={`0 0 ${sc.width} ${sc.height}`} role="img" aria-label={s.scenarios[i]?.label}>
          {Array.from({ length: sc.n }, (_, k) => (
            <g>
              {sc.conflicts.includes(k + 1) && (
                <rect class="conflict-col" x={x(k + 1)} y={TOP - 6} width={COL} height={sc.height - TOP + 2} rx="6" />
              )}
              <text class="tick" x={x(k + 1) + COL / 2} y="14" text-anchor="middle">{k + 1}</text>
              <line class="grid" x1={x(k + 1)} x2={x(k + 1)} y1="20" y2={sc.height} />
            </g>
          ))}
          {sc.borrows.map((b, r) => {
            const y = TOP + r * ROW;
            return (
              <g class={`bar-row ${b.kind}`} data-from={b.from} data-to={b.to} tabindex="0" style={`--r:${r}`}>
                <text class="row-label" x="0" y={y + 18}>{b.label}</text>
                {b.lexicalTo && b.lexicalTo > b.to && (
                  <rect class="ghost" x={x(b.to + 1) + 3} y={y + 5} width={(b.lexicalTo - b.to) * COL - 6} height="16" rx="8" />
                )}
                <rect class="bar" x={x(b.from) + 3} y={y + 4} width={(b.to - b.from + 1) * COL - 6} height="18" rx="9" />
              </g>
            );
          })}
        </svg>
      </div>
      {s.errors[i] && <pre class="bt-error">{s.errors[i]}</pre>}
      <div class="widget-caption"><p set:html={s.scenarios[i]?.text} /></div>
    </div>
  ))}

  <div class="bt-legend">
    <span><i class="sw shared" />{s.shared}</span>
    <span><i class="sw mut" />{s.mut}</span>
    <span><i class="sw conflict" />{s.conflict}</span>
    <span><i class="sw ghost" />{s.lexical}</span>
  </div>
</WidgetFrame>

<script>
  class BorrowTimeline extends HTMLElement {
    connectedCallback() {
      const tabs = this.querySelectorAll<HTMLButtonElement>('[data-tab]');
      tabs.forEach((t) =>
        t.addEventListener('click', () => {
          tabs.forEach((x) => {
            x.setAttribute('aria-pressed', String(x === t));
            x.setAttribute('aria-selected', String(x === t));
          });
          this.querySelectorAll<HTMLElement>('[data-scenario]').forEach((p) => (p.hidden = p.dataset.scenario !== t.dataset.tab));
        }),
      );
      this.querySelectorAll<SVGGElement>('.bar-row').forEach((row) => {
        const scenario = row.closest<HTMLElement>('[data-scenario]')!;
        const mark = (on: boolean) => {
          const from = Number(row.dataset.from);
          const to = Number(row.dataset.to);
          scenario.querySelectorAll<HTMLElement>('.ln').forEach((ln) => {
            const l = Number(ln.dataset.line);
            ln.classList.toggle('is-active', on && l >= from && l <= to);
          });
          row.classList.toggle('hot', on);
        };
        row.addEventListener('mouseenter', () => mark(true));
        row.addEventListener('mouseleave', () => mark(false));
        row.addEventListener('focus', () => mark(true));
        row.addEventListener('blur', () => mark(false));
      });
    }
  }
  customElements.define('borrow-timeline', BorrowTimeline);
</script>

<style>
  borrow-timeline { display: block; }
  .bt-tabs { flex-wrap: wrap; border-radius: var(--radius); }
  .bt-tabs > button { border-radius: calc(var(--radius) - 3px); }
  .bt-scenario { display: grid; gap: var(--space-3); &[hidden] { display: none; } }
  .bt-status {
    display: inline-flex; align-items: center; gap: var(--space-2); justify-self: start;
    padding: 0.2rem 0.7rem; border-radius: var(--radius-full); font-size: 0.78rem; font-weight: 650;
    background: color-mix(in oklch, var(--ok) 14%, var(--surface)); color: var(--ok);
    &[data-valid='false'] { background: color-mix(in oklch, var(--invalid) 14%, var(--surface)); color: var(--invalid); }
  }
  .code-lines { font-size: 0.8rem; }
  .bt-chart-wrap { overflow-x: auto; scrollbar-width: thin; }
  .bt-chart { inline-size: 100%; max-inline-size: 36rem; min-inline-size: 26rem; block-size: auto; font-family: var(--font-mono); overflow: visible; }
  .tick { font-size: 11px; fill: var(--text-faint); }
  .grid { stroke: var(--border); stroke-dasharray: 2 3; }
  .row-label { font-size: 11.5px; fill: var(--text-muted); }
  .conflict-col { fill: color-mix(in oklch, var(--invalid) 14%, transparent); stroke: color-mix(in oklch, var(--invalid) 50%, transparent); stroke-dasharray: 4 3; }
  .bar-row { outline: none; cursor: default; }
  .bar {
    transform-box: fill-box; transform-origin: left center;
    animation: bt-grow 600ms var(--ease-out) both; animation-delay: calc(var(--r) * 110ms);
    transition: filter var(--dur);
  }
  .shared .bar { fill: color-mix(in srgb, var(--borrow) 55%, var(--surface)); stroke: var(--borrow); }
  .mut .bar { fill: color-mix(in srgb, var(--borrow-mut) 60%, var(--surface)); stroke: var(--borrow-mut); }
  .bar-row.hot .bar { filter: drop-shadow(0 0 6px color-mix(in oklch, var(--accent) 60%, transparent)); }
  .bar-row.hot .row-label { fill: var(--text); font-weight: 700; }
  .ghost { fill: none; stroke: var(--text-faint); stroke-dasharray: 4 4; opacity: 0.8; }
  @keyframes bt-grow { from { scale: 0 1; } }
  @media (prefers-reduced-motion: reduce) { .bar { animation: none; } }
  .bt-error {
    margin: 0; padding: var(--space-2) var(--space-3); border-radius: var(--radius-s);
    font-size: 0.78rem; white-space: pre-wrap;
    background: color-mix(in oklch, var(--invalid) 10%, var(--surface)); color: var(--invalid);
    border: 1px solid color-mix(in oklch, var(--invalid) 35%, transparent);
  }
  .bt-legend {
    display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); font-size: 0.75rem; color: var(--text-muted);
    & span { display: inline-flex; align-items: center; gap: var(--space-2); }
  }
  .sw { display: inline-block; inline-size: 1.4rem; block-size: 0.7rem; border-radius: 1rem; }
  .sw.shared { background: color-mix(in srgb, var(--borrow) 55%, var(--surface)); border: 1px solid var(--borrow); }
  .sw.mut { background: color-mix(in srgb, var(--borrow-mut) 60%, var(--surface)); border: 1px solid var(--borrow-mut); }
  .sw.conflict { background: color-mix(in oklch, var(--invalid) 14%, transparent); border: 1px dashed var(--invalid); border-radius: 3px; }
  .sw.ghost { border: 1px dashed var(--text-faint); }
</style>
