---
/**
 * REFERENCE WIDGET — copy this structure for new widgets:
 *  1. strings in src/i18n/locales/<lang>/widgets/<kebab-name>.json
 *  2. markup rendered at build time inside <WidgetFrame tag="x-custom-element">
 *  3. behaviour in a bundled <script> defining that custom element
 *  4. scoped <style>, using design tokens from global.css only
 */
import WidgetFrame from '@/components/content/WidgetFrame.astro';
import Icon from '@/components/Icon.astro';
import { getLang, widgetStrings } from '@/i18n';

interface Strings {
  title: string; subtitle: string; play: string; pause: string;
  stages: { name: string; short: string; text: string }[];
}
const s = widgetStrings<Strings>(getLang(Astro), 'compile-pipeline');
const W = 640;
const step = W / s.stages.length;
---
<WidgetFrame tag="compile-pipeline" title={s.title} subtitle={s.subtitle} icon="cpu" data-play={s.play} data-pause={s.pause}>
  <svg class="pipe" viewBox={`0 0 ${W} 120`} role="tablist" aria-label={s.title}>
    <line x1={step / 2} y1="46" x2={W - step / 2} y2="46" class="rail" />
    <line x1={step / 2} y1="46" x2={W - step / 2} y2="46" class="rail-fill" pathLength="100" />
    {
      s.stages.map((st, i) => (
        <g class="stage" role="tab" tabindex={i === 0 ? 0 : -1} aria-selected={i === 0 ? 'true' : 'false'} data-index={i} transform={`translate(${step * i + step / 2} 46)`}>
          <circle r="22" class="halo" />
          <circle r="15" class="node" />
          <text y="5" text-anchor="middle" class="idx">{i + 1}</text>
          <text y="48" text-anchor="middle" class="name">{st.name}</text>
          <text y="64" text-anchor="middle" class="short">{st.short}</text>
        </g>
      ))
    }
  </svg>
  <div class="widget-caption" aria-live="polite">
    {s.stages.map((st, i) => <p data-caption={i} hidden={i !== 0} set:html={st.text} />)}
  </div>
  <div class="widget-controls">
    <button type="button" class="btn btn-sm" data-toggle><Icon name="play" size={14} /><span>{s.play}</span></button>
  </div>
</WidgetFrame>

<script>
  class CompilePipeline extends HTMLElement {
    #i = 0;
    #timer: number | undefined;

    connectedCallback() {
      this.querySelectorAll<SVGGElement>('.stage').forEach((g) => {
        g.addEventListener('click', () => { this.stop(); this.select(Number(g.dataset.index)); });
        g.addEventListener('keydown', (e) => {
          const n = this.querySelectorAll('.stage').length;
          if (e.key === 'ArrowRight') this.select((this.#i + 1) % n, true);
          if (e.key === 'ArrowLeft') this.select((this.#i - 1 + n) % n, true);
        });
      });
      this.querySelector('[data-toggle]')!.addEventListener('click', () => (this.#timer ? this.stop() : this.play()));
      this.select(0);
    }

    disconnectedCallback() { this.stop(); }

    select(i: number, focus = false) {
      this.#i = i;
      const stages = this.querySelectorAll<SVGGElement>('.stage');
      stages.forEach((g, k) => {
        g.setAttribute('aria-selected', String(k === i));
        g.setAttribute('tabindex', k === i ? '0' : '-1');
        g.classList.toggle('done', k < i);
      });
      if (focus) stages[i]?.focus();
      this.querySelectorAll<HTMLElement>('[data-caption]').forEach((p) => (p.hidden = Number(p.dataset.caption) !== i));
      this.style.setProperty('--progress', String((i / (stages.length - 1)) * 100));
    }

    play() {
      const n = this.querySelectorAll('.stage').length;
      if (this.#i === n - 1) this.select(0);
      this.#setButton(true);
      this.#timer = window.setInterval(() => {
        if (this.#i >= n - 1) return this.stop();
        this.select(this.#i + 1);
      }, 2200);
    }

    stop() {
      clearInterval(this.#timer);
      this.#timer = undefined;
      this.#setButton(false);
    }

    #setButton(playing: boolean) {
      const btn = this.querySelector('[data-toggle]')!;
      btn.querySelector('span')!.textContent = playing ? this.dataset.pause! : this.dataset.play!;
      btn.querySelector('svg')!.innerHTML = playing ? '<path d="M8 5v14M16 5v14"/>' : '<path d="M7 4.5v15l12.5-7.5z"/>';
    }
  }
  customElements.define('compile-pipeline', CompilePipeline);
</script>

<style>
  compile-pipeline { display: block; --progress: 0; }
  .pipe { inline-size: 100%; overflow: visible; font-family: var(--font-sans); }
  .rail { stroke: var(--border); stroke-width: 4; stroke-linecap: round; }
  .rail-fill {
    stroke: var(--accent); stroke-width: 4; stroke-linecap: round;
    stroke-dasharray: 100; stroke-dashoffset: calc(100 - var(--progress));
    transition: stroke-dashoffset 600ms var(--ease-out);
  }
  .stage { cursor: pointer; outline: none; }
  .node { fill: var(--surface); stroke: var(--border-strong); stroke-width: 2; transition: fill var(--dur), stroke var(--dur); }
  .halo { fill: var(--accent-soft); scale: 0; transition: scale 400ms var(--ease-spring); }
  .idx { font: 700 12px var(--font-mono); fill: var(--text-muted); pointer-events: none; }
  .name { font-size: 13px; font-weight: 650; fill: var(--text); }
  .short { font: 11px var(--font-mono); fill: var(--text-faint); }
  .stage:hover .node { stroke: var(--accent); }
  .stage.done .node { fill: color-mix(in oklch, var(--accent) 25%, var(--surface)); stroke: var(--accent); }
  .stage[aria-selected='true'] {
    & .node { fill: var(--accent); stroke: var(--accent-strong); }
    & .idx { fill: var(--on-accent); }
    & .halo { scale: 1; animation: pulse 1.8s ease-in-out infinite; }
  }
  .stage:focus-visible .halo { scale: 1.2; }
  @keyframes pulse { 50% { scale: 1.25; opacity: 0.5; } }
  [data-caption] { animation: fade-up 400ms var(--ease-out); }
  @container widget (width < 30rem) { .short { display: none; } .name { font-size: 11px; } }
</style>
