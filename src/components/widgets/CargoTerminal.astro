---
/**
 * Simulated terminal: types a cargo command, then streams canned output.
 * Output lines may carry a style prefix: "dim|", "hl|", "ok|", "warn|", "err|",
 * and test lines may end in "|ok" to colour the result.
 */
import WidgetFrame from '@/components/content/WidgetFrame.astro';
import Icon from '@/components/Icon.astro';
import { getLang, widgetStrings } from '@/i18n';

interface Command { cmd: string; output: string[]; explain: string }
interface Strings { title: string; subtitle: string; simulation: string; replay: string; commands: Record<string, Command> }
const s = widgetStrings<Strings>(getLang(Astro), 'cargo-terminal');
const entries = Object.entries(s.commands);
---
<WidgetFrame tag="cargo-terminal" title={s.title} subtitle={s.subtitle} icon="terminal" data-commands={JSON.stringify(s.commands)}>
  <div class="ct-chips" role="tablist" aria-label={s.title}>
    {entries.map(([id, c], i) => (
      <button type="button" role="tab" class="ct-chip" data-cmd={id} aria-selected={i === 0 ? 'true' : 'false'}>
        <code>{c.cmd}</code>
      </button>
    ))}
  </div>

  <div class="ct-term">
    <div class="ct-bar">
      <span class="ct-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="ct-path">~/timeparse</span>
      <span class="ct-badge">{s.simulation}</span>
      <button type="button" class="ct-replay" data-replay title={s.replay}><Icon name="reset" size={14} /><span class="sr-only">{s.replay}</span></button>
    </div>
    <pre class="ct-screen" aria-live="polite"><span class="ct-prompt">$ </span><span data-typed></span><span class="ct-cursor" aria-hidden="true"></span>
<span data-out></span></pre>
  </div>

  <div class="widget-caption" data-explain set:html={entries[0]?.[1].explain} />
</WidgetFrame>

<script>
  interface Command { cmd: string; output: string[]; explain: string }
  const STYLE = /^(dim|hl|ok|warn|err)\|/;
  const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  function renderLine(raw: string): string {
    const m = STYLE.exec(raw);
    let text = m ? raw.slice(m[0].length) : raw;
    let tail = '';
    if (text.endsWith(' ... ok|ok')) {
      text = text.slice(0, -'ok|ok'.length);
      tail = '<span class="c-ok">ok</span>';
    }
    return `<span class="${m ? `c-${m[1]}` : ''}">${esc(text)}</span>${tail}\n`;
  }

  class CargoTerminal extends HTMLElement {
    #commands: Record<string, Command> = {};
    #run = 0;
    #current = '';

    connectedCallback() {
      this.#commands = JSON.parse(this.dataset.commands ?? '{}');
      this.querySelectorAll<HTMLButtonElement>('[data-cmd]').forEach((b) =>
        b.addEventListener('click', () => this.play(b.dataset.cmd!)),
      );
      this.querySelector('[data-replay]')!.addEventListener('click', () => this.play(this.#current));
      // start typing the first command once the widget scrolls into view
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          if (this.#run === 0) this.play(Object.keys(this.#commands)[0]!);
        }
      }, { threshold: 0.4 });
      io.observe(this);
    }

    async play(id: string) {
      const c = this.#commands[id];
      if (!c) return;
      const run = ++this.#run;
      this.#current = id;
      const instant = matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.querySelectorAll<HTMLButtonElement>('[data-cmd]').forEach((b) =>
        b.setAttribute('aria-selected', String(b.dataset.cmd === id)),
      );
      this.querySelector('[data-explain]')!.innerHTML = c.explain;
      const typed = this.querySelector<HTMLElement>('[data-typed]')!;
      const out = this.querySelector<HTMLElement>('[data-out]')!;
      const screen = this.querySelector<HTMLElement>('.ct-screen')!;
      typed.textContent = '';
      out.innerHTML = '';
      this.classList.add('is-typing');

      for (const ch of c.cmd) {
        if (run !== this.#run) return;
        typed.textContent += ch;
        if (!instant) await sleep(35 + Math.random() * 45);
      }
      if (!instant) await sleep(260);
      this.classList.remove('is-typing');
      for (const line of c.output) {
        if (run !== this.#run) return;
        out.insertAdjacentHTML('beforeend', renderLine(line));
        screen.scrollTop = screen.scrollHeight;
        if (!instant) await sleep(line.startsWith('dim|') ? 70 : 45);
      }
    }
  }
  customElements.define('cargo-terminal', CargoTerminal);
</script>

<style>
  cargo-terminal { display: block; }
  .ct-chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .ct-chip {
    padding: 0.3rem 0.75rem; border-radius: var(--radius-full); border: 1px solid var(--border-strong);
    background: var(--surface); color: var(--text-muted);
    transition: background-color var(--dur), color var(--dur), border-color var(--dur);
    & code { font-size: 0.78rem; background: none; border: 0; padding: 0; color: inherit; }
    &:hover { color: var(--text); border-color: var(--accent); }
    &[aria-selected='true'] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  }

  .ct-term { border-radius: var(--radius); overflow: hidden; border: 1px solid var(--code-border); background: var(--code-bg); }
  .ct-bar {
    display: flex; align-items: center; gap: var(--space-3); padding: 0.45rem var(--space-3);
    background: var(--surface-2); border-block-end: 1px solid var(--code-border);
    font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-faint);
  }
  .ct-dots { display: inline-flex; gap: 6px;
    & i { inline-size: 10px; block-size: 10px; border-radius: 50%; background: var(--border-strong); }
    & i:nth-child(1) { background: color-mix(in oklch, var(--danger) 70%, var(--surface)); }
    & i:nth-child(2) { background: color-mix(in oklch, var(--warn) 70%, var(--surface)); }
    & i:nth-child(3) { background: color-mix(in oklch, var(--ok) 70%, var(--surface)); }
  }
  .ct-badge {
    margin-inline-start: auto; padding: 0.05rem 0.5rem; border-radius: var(--radius-full);
    font-family: var(--font-sans); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; font-size: 0.62rem;
    border: 1px dashed var(--border-strong);
  }
  .ct-replay {
    display: inline-grid; place-items: center; inline-size: 1.6rem; block-size: 1.6rem;
    border: 0; border-radius: var(--radius-s); background: transparent; color: var(--text-muted);
    &:hover { background: var(--surface-3); color: var(--text); }
  }
  .ct-screen {
    margin: 0; padding: var(--space-3) var(--space-4); block-size: 19rem; overflow: auto;
    font-family: var(--font-mono); font-size: 0.76rem; line-height: 1.55; color: var(--text);
    white-space: pre; scrollbar-width: thin;
  }
  .ct-prompt { color: var(--ok); font-weight: 700; }
  .ct-cursor {
    display: inline-block; inline-size: 0.55em; block-size: 1.1em; vertical-align: text-bottom;
    background: var(--accent); animation: blink 1s steps(1) infinite;
  }
  cargo-terminal.is-typing .ct-cursor { animation: none; }
  cargo-terminal:not(.is-typing) .ct-cursor { display: none; }
  @keyframes blink { 50% { opacity: 0; } }
  .ct-screen :global(.c-dim) { color: var(--text-faint); }
  .ct-screen :global(.c-hl) { color: var(--info); }
  .ct-screen :global(.c-ok) { color: var(--ok); }
  .ct-screen :global(.c-warn) { color: var(--warn); font-weight: 600; }
  .ct-screen :global(.c-err) { color: var(--danger); }
  @container widget (width < 30rem) { .ct-path { display: none; } .ct-screen { font-size: 0.68rem; } }
</style>
