---
/**
 * <Callout type="note|tip|warn|runtime|compare" title="optional">…markdown…</Callout>
 * For type="compare" pass `from="JavaScript"` to label the source language.
 */
import Icon from '@/components/Icon.astro';
import { getLang, useTranslations } from '@/i18n';

interface Props { type?: 'note' | 'tip' | 'warn' | 'runtime' | 'compare'; title?: string; from?: string }
const { type = 'note', title, from } = Astro.props;
const { t } = useTranslations(getLang(Astro));
const icons = { note: 'info', tip: 'bulb', warn: 'alert', runtime: 'cpu', compare: 'swap' } as const;
const heading = title ?? (type === 'compare' && from ? `${t('lesson.comingFrom')} ${from}` : t(`callout.${type}`));
---
<aside class={`callout callout-${type}`}>
  <div class="callout-title"><Icon name={icons[type]} size={18} /><span>{heading}</span></div>
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    --c: var(--info);
    position: relative;
    margin-block: var(--space-5);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius);
    background: color-mix(in oklch, var(--c) 8%, var(--surface));
    border: 1px solid color-mix(in oklch, var(--c) 30%, var(--border));
    border-inline-start: 4px solid var(--c);
    font-size: 0.95em;
  }
  .callout-tip { --c: var(--ok); }
  .callout-warn { --c: var(--warn); }
  .callout-runtime { --c: var(--violet); }
  .callout-compare { --c: var(--accent); }
  .callout-title {
    display: flex; align-items: center; gap: var(--space-2);
    font-weight: 650; color: color-mix(in oklch, var(--c) 75%, var(--text)); margin-block-end: var(--space-2);
  }
  .callout-body > :global(* + *) { margin-block-start: var(--space-3); }
  .callout-body :global(pre) { font-size: 0.82rem; }
</style>
